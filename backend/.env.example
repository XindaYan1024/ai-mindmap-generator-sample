# Which AI backend to use: ollama | claude | mock
AI_PROVIDER=ollama

# Ollama (local, free, no key) — used when AI_PROVIDER=ollama
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://localhost:11434

# Anthropic Claude — used when AI_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-5
